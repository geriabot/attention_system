# TurtleBot 2 / Kobuki (kobuki_attention_actuation), including the Astra camera
repositories:
  third_party/kobuki:
    type: git
    url: https://github.com/IntelligentRoboticsLabs/kobuki.git
    version: jazzy
  third_party/kobuki_deps/kobuki_core:
    type: git
    url: https://github.com/kobuki-base/kobuki_core.git
    version: devel
  third_party/kobuki_deps/kobuki_ros:
    type: git
    url: https://github.com/Juancams/kobuki_ros.git
    version: jazzy-devel
  third_party/kobuki_deps/kobuki_ros_interfaces:
    type: git
    url: https://github.com/kobuki-base/kobuki_ros_interfaces.git
    version: devel
  third_party/kobuki_deps/ecl/ecl_tools:
    type: git
    url: https://github.com/stonier/ecl_tools.git
    version: devel
  third_party/kobuki_deps/ecl/ecl_core:
    type: git
    url: https://github.com/Juancams/ecl_core.git
    version: devel
  third_party/kobuki_deps/ecl/ecl_lite:
    type: git
    url: https://github.com/Juancams/ecl_lite.git
    version: ros2-jazzy
  third_party/kobuki_deps/ros_astra_camera:
    type: git
    url: https://github.com/Juancams/ros_astra_camera.git
    version: rolling
  third_party/kobuki_deps/openni2_camera:
    type: git
    url: https://github.com/ros-drivers/openni2_camera.git
    version: ros2
  third_party/kobuki_deps/rplidar_ros:
    type: git
    url: https://github.com/Juancams/rplidar_ros.git
    version: ros2
  third_party/kobuki_deps/aws-robomaker-small-warehouse-world:
    type: git
    url: https://github.com/Juancams/aws-robomaker-small-warehouse-world.git
    version: ros2-jazzy
  third_party/kobuki_deps/aws-robomaker-small-house-world:
    type: git
    url: https://github.com/Juancams/aws-robomaker-small-house-world
    version: ros2-jazzy
  third_party/kobuki_deps/aws-robomaker-racetrack-world:
    type: git
    url: https://github.com/Juancams/aws-robomaker-racetrack-world.git
    version: ros2-jazzy
  third_party/kobuki_deps/aws-robomaker-bookstore-world:
    type: git
    url: https://github.com/Juancams/aws-robomaker-bookstore-world.git
    version: ros2-jazzy
